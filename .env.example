# Copy this file to deploy/.env.{change-me-env-name} and replace every example value.
# Do not commit deploy/.env.XXXX or any file containing real secrets.

# Local 테스트 환경을 구축하는 경우, 아래 환경변수만을 복사해서 설정합니다.
##################################################################################################
TRAVEL_HUNTER_PUBLIC_BASE_URL=change-me-public-base-url-like-{https://your-domain.co.kr}
# TRAVEL_HUNTER_PUBLIC_BASE_URL=http://127.0.0.1:4173
# 포트 지정 주의. 일반적인 로컬 실행 환경의 경우, 4173 포트. vite의 HMR 대응 실행 환경의 경우 5173 포트.

SMTP_HOST=change-me-smtp-host
SMTP_PORT=587
SMTP_USERNAME=change-me-smtp-username
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM_EMAIL=change-me-like-{no-reply@{your-domain.co.kr}}
SMTP_USE_TLS=true
KAKAO_CLIENT_ID=change-me-kakao-client-id
KAKAO_CLIENT_SECRET=change-me-kakao-client-secret
KAKAO_REDIRECT_URI=change-me-like-{{https://your-domain.co.kr}/api/auth/oauth/kakao/callback}
KAKAO_LOCAL_ENABLED=change-me-{true | false}
KAKAO_LOCAL_REST_API_KEY=change-me-kakao-local-rest-api-key
KAKAO_LOCAL_TIMEOUT_SECONDS=5
# TourAPI (data.go.kr 한국관광공사) — 정책 카드 지역 사진 백필용. 꺼져 있으면 전체 no-op.
TOUR_API_ENABLED=change-me-{true | false}
TOUR_API_SERVICE_KEY=change-me-data-go-kr-service-key
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService1
TOUR_API_TIMEOUT_SECONDS=5
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_REDIRECT_URI=change-me-like-{{https://your-domain.co.kr}/api/auth/oauth/google/callback}
##################################################################################################
# Local 테스트 환경을 구축하는 경우, 위 환경변수만을 복사해서 설정합니다.

STAGING_DOMAIN=change-me-like-{your-domain.co.kr}
VITE_API_BASE_URL=change-me-api-base-url-like-{https://your-domain.co.kr}
VITE_KAKAO_MAP_JS_KEY=change-me-kakao-javascript-key


POSTGRES_DB=change-me-db-name
POSTGRES_USER=change-me-db-username
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=change-me-db-url-like-{postgresql+psycopg://{db-username}:{db-password}@db:5432/{db-name}}

APP_ENV=change-me-{local | staging | develop | production}
AUTH_SECRET_KEY=change-me-use-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=travel_hunter_refresh
REFRESH_COOKIE_SECURE=change-me-{true | false}
CORS_ORIGINS=change-me-cors-origins-like-{https://your-domain.co.kr}
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_RUN_AT=09:00
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=600
EXTERNAL_COLLECTION_SCHEDULER_ENABLED=change-me-{true | false}
EXTERNAL_COLLECTION_RUN_AT=03:00
EXTERNAL_COLLECTION_POLL_SECONDS=60
EXTERNAL_COLLECTION_MIN_PARSED_COUNT=1
# One-shot local-only Alembic opt-in for 0024_local_kst_time_shift.
# Leave unset for normal alembic upgrade head; set only for the guarded local data shift.
# TRAVEL_HUNTER_ALLOW_LOCAL_TIMEZONE_DATA_SHIFT=1
PASSWORD_RESET_EXPIRE_MINUTES=30
OAUTH_STATE_COOKIE_NAME=travel_hunter_oauth_state

CLOUDFLARE_TUNNEL_TOKEN=change-me-cloudflare-tunnel-token
