APP_ENV=local
DATABASE_URL=postgresql+psycopg://travelhunter:travelhunter@127.0.0.1:55432/travelhunter
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
AUTH_SECRET_KEY=dev-only-change-me-secret-key-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=travel_hunter_refresh
REFRESH_COOKIE_SECURE=false
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_RUN_AT=09:00
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=600
EXTERNAL_COLLECTION_SCHEDULER_ENABLED=false
EXTERNAL_COLLECTION_RUN_AT=03:00
EXTERNAL_COLLECTION_POLL_SECONDS=60
# One-shot local-only Alembic opt-in for 0024_local_kst_time_shift.
# Leave unset for normal alembic upgrade head; set only for the guarded local data shift.
# TRAVEL_HUNTER_ALLOW_LOCAL_TIMEZONE_DATA_SHIFT=1
TRAVEL_HUNTER_PUBLIC_BASE_URL=http://127.0.0.1:4173
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/kakao/callback
KAKAO_LOCAL_ENABLED=false
KAKAO_LOCAL_REST_API_KEY=
KAKAO_LOCAL_TIMEOUT_SECONDS=5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback
OAUTH_STATE_COOKIE_NAME=travel_hunter_oauth_state

# Production uses a managed PostgreSQL URL, a strong secret, HTTPS-only cookies,
# and the confirmed public domain. See deploy/.env.prod.example for the full safe template.
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://travelhunter:change-me@db:5432/travelhunter
# CORS_ORIGINS=https://travel-hunter.co.kr
# TRAVEL_HUNTER_PUBLIC_BASE_URL=https://travel-hunter.co.kr
# GOOGLE_REDIRECT_URI=https://travel-hunter.co.kr/api/auth/oauth/google/callback
# KAKAO_REDIRECT_URI=https://travel-hunter.co.kr/api/auth/oauth/kakao/callback
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_FROM_EMAIL=no-reply@travel-hunter.co.kr
# AUTH_SECRET_KEY=replace-with-a-long-random-secret
# REFRESH_COOKIE_SECURE=true
# NOTIFICATION_SCHEDULER_ENABLED=false
# EXTERNAL_COLLECTION_SCHEDULER_ENABLED=true
