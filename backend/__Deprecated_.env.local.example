TRAVEL_HUNTER_PUBLIC_BASE_URL=http://127.0.0.1:4173 # 포트 지정 주의. 일반적인 로컬 실행 환경의 경우, 4173 포트. vite의 HMR 대응 실행 환경의 경우 5173 포트.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=sender@example.com
SMTP_USE_TLS=true
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/kakao/callback
KAKAO_LOCAL_ENABLED=false
KAKAO_LOCAL_REST_API_KEY=your-kakao-local-rest-api-key
KAKAO_LOCAL_TIMEOUT_SECONDS=5
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oauth/google/callback

