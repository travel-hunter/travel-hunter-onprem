# Copy this file to deploy/.env.prod on the production/tunnel host and replace every example value.
# Do not commit deploy/.env.prod or any file containing real secrets.

STAGING_DOMAIN=travel-hunter.co.kr
VITE_API_BASE_URL=https://travel-hunter.co.kr
VITE_KAKAO_MAP_JS_KEY=change-me-kakao-javascript-key

POSTGRES_DB=travelhunter
POSTGRES_USER=travelhunter
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+psycopg://travelhunter:change-me-db-password@db:5432/travelhunter

APP_ENV=production
AUTH_SECRET_KEY=change-me-use-a-long-random-secret-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_NAME=travel_hunter_refresh
REFRESH_COOKIE_SECURE=true
CORS_ORIGINS=https://travel-hunter.co.kr
NOTIFICATION_SCHEDULER_ENABLED=false
NOTIFICATION_RUN_AT=09:00
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_RETRY_ENABLED=true
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=600
EXTERNAL_COLLECTION_SCHEDULER_ENABLED=true
EXTERNAL_COLLECTION_RUN_AT=03:00
EXTERNAL_COLLECTION_POLL_SECONDS=60
EXTERNAL_COLLECTION_MIN_PARSED_COUNT=1
TRAVEL_HUNTER_PUBLIC_BASE_URL=https://travel-hunter.co.kr
PASSWORD_RESET_EXPIRE_MINUTES=30
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=change-me-brevo-smtp-login
SMTP_PASSWORD=change-me-brevo-smtp-key
SMTP_FROM_EMAIL=no-reply@travel-hunter.co.kr
SMTP_USE_TLS=true
KAKAO_CLIENT_ID=change-me-kakao-client-id
KAKAO_CLIENT_SECRET=change-me-kakao-client-secret
KAKAO_REDIRECT_URI=https://travel-hunter.co.kr/api/auth/oauth/kakao/callback
KAKAO_LOCAL_ENABLED=true
KAKAO_LOCAL_REST_API_KEY=change-me-kakao-local-rest-api-key
KAKAO_LOCAL_TIMEOUT_SECONDS=5
GOOGLE_CLIENT_ID=change-me-google-client-id
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_REDIRECT_URI=https://travel-hunter.co.kr/api/auth/oauth/google/callback
OAUTH_STATE_COOKIE_NAME=travel_hunter_oauth_state

CLOUDFLARE_TUNNEL_TOKEN=change-me-cloudflare-tunnel-token
