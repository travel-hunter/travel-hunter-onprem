pipeline {
    agent { label 'dev' }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50', daysToKeepStr: '30'))
        timestamps()
    }

    environment {
        PROJECT_DIR = "/home/deploy/travel-hunter-onprem"
        BRANCH_NAME = "develop"

        ENV_FILE = "deploy/.env.dev"
        COMPOSE_FILE = "compose.yaml"
        COMPOSE_PROJECT_NAME = "travel-hunter-onprem"

        DEV_DOMAIN = "dev.travel-hunter.co.kr"
        DEV_URL = "https://dev.travel-hunter.co.kr"

        SLACK_CHANNEL = "#travel-hunter-build"
    }

    stages {

        stage('Notify Build Start') {
            steps {
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: '#439FE0',
                    failOnError: false,
                    message: """
🚀 *[DEV] Travel Hunter 개발서버 배포 시작*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 확인>
                    """.stripIndent().trim()
                )
            }
        }


        stage('Check Environment') {
            steps {
                sh '''
                    echo "===== 실행 위치 확인 ====="

                    whoami
                    hostname
                    pwd

                    echo "===== 도구 확인 ====="

                    git --version
                    docker --version
                    docker compose version

                    echo "===== Compose Project ====="

                    echo "COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}"

                    echo "===== 프로젝트 확인 ====="

                    cd ${PROJECT_DIR}

                    pwd
                    ls -al

                    echo "===== Git 상태 ====="

                    git status
                '''
            }
        }


        stage('Pull Latest Code') {
            steps {
                sh '''
                    echo "===== 최신 코드 가져오기 ====="

                    cd ${PROJECT_DIR}

                    git config --global --add safe.directory ${PROJECT_DIR}

                    git fetch origin
                    git checkout ${BRANCH_NAME}
                    git pull origin ${BRANCH_NAME}
                '''
            }
        }


        stage('Validate Compose') {
            steps {
                sh '''
                    echo "===== Compose 설정 검증 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      config > /dev/null

                    echo "Compose configuration OK"
                '''
            }
        }


        stage('Build Images') {
            steps {
                sh '''
                    echo "===== Docker Image Build ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      build
                '''
            }
        }


        stage('Run DB Migration') {
            steps {
                sh '''
                    echo "===== DB Migration 실행 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      run --rm backend \
                      python -m alembic upgrade head
                '''
            }
        }


        stage('Deploy') {
            steps {
                sh '''
                    echo "===== 개발 서비스 배포 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      up -d --wait --wait-timeout 120
                '''
            }
        }


        stage('Check Containers') {
            steps {
                sh '''
                    echo "===== 컨테이너 상태 확인 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      ps
                '''
            }
        }


        stage('Health Check') {
            steps {
                sh '''
                    echo "===== 내부 Caddy 테스트 ====="

                    cd ${PROJECT_DIR}

                    docker run --rm \
                      --network ${COMPOSE_PROJECT_NAME}_default \
                      curlimages/curl:8.11.1 \
                      -I \
                      -H "Host: ${DEV_DOMAIN}" \
                      http://caddy:80

                    echo "===== 외부 도메인 테스트 ====="

                    curl -fsS \
                      -o /dev/null \
                      -I ${DEV_URL} || {
                        echo "⚠️ 개발 도메인 응답 없음"
                        exit 1
                    }

                    echo "Health Check OK"
                '''
            }
        }
    }


    post {

        success {
            echo "개발 서버 배포 성공"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "good",
                failOnError: false,
                message: """
✅ *[DEV] Travel Hunter 개발서버 배포 성공*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• 소요 시간: `${currentBuild.durationString.replace(' and counting', '')}`
• 서비스: <${env.DEV_URL}|${env.DEV_DOMAIN}>
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        failure {
            echo "개발 서버 배포 실패. Jenkins Console Output 확인 필요"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "danger",
                failOnError: false,
                message: """
❌ *[DEV] Travel Hunter 개발서버 배포 실패*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        unstable {
            echo "빌드 결과 불안정"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "warning",
                failOnError: false,
                message: """
⚠️ *[DEV] Travel Hunter 개발서버 빌드 상태 불안정*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        aborted {
            echo "빌드 취소"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "warning",
                failOnError: false,
                message: """
⛔ *[DEV] Travel Hunter 개발서버 배포 취소*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }

    }
}