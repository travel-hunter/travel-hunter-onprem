pipeline {
    agent { label 'dev' }

    options {
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50', daysToKeepStr: '30'))
        timestamps()
    }

    environment {
        PROJECT_DIR = "/home/deploy/travel-hunter-onprem"
        BRANCH_NAME = "develop"

        ENV_FILE = "deploy/.env.dev"
        COMPOSE_FILE = "compose.yaml"
        COMPOSE_PROJECT_NAME = "travel-hunter-onprem"

        DEV_DOMAIN = "dev.travel-hunter.co.kr"
        DEV_URL = "https://dev.travel-hunter.co.kr"

        SLACK_CHANNEL = "#travel-hunter-build"
    }

    stages {

        stage('Notify Build Start') {
            steps {
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: '#439FE0',
                    failOnError: false,
                    message: """
🚀 *[DEV] Travel Hunter 개발서버 배포 시작*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 확인>
                    """.stripIndent().trim()
                )
            }
        }


        stage('Check Environment') {
            steps {
                sh '''
                    echo "===== 실행 위치 확인 ====="

                    whoami
                    hostname
                    pwd

                    echo "===== 도구 확인 ====="

                    git --version
                    docker --version
                    docker compose version

                    echo "===== Compose Project ====="

                    echo "COMPOSE_PROJECT_NAME=${COMPOSE_PROJECT_NAME}"

                    echo "===== 프로젝트 확인 ====="

                    cd ${PROJECT_DIR}

                    pwd
                    ls -al

                    echo "===== Git 상태 ====="

                    git status
                '''
            }
        }


        stage('Pull Latest Code') {
            steps {
                sh '''
                    echo "===== 최신 코드 가져오기 ====="

                    cd ${PROJECT_DIR}

                    git config --global --add safe.directory ${PROJECT_DIR}

                    git fetch origin
                    git checkout ${BRANCH_NAME}
                    git pull origin ${BRANCH_NAME}
                '''
            }
        }

        stage('Backend Tests') {
            steps {
                sh '''
                    echo "===== 백엔드 테스트 ====="
                    cd ${PROJECT_DIR}

                    # 배포 전에 검사한다. 테스트 전용 이미지를 따로 굽는다 —
                    # 이름이 고정돼 compose 프로젝트명 규칙에 의존하지 않는다.
                    docker build -t travel-hunter-backend-test ./backend

                    # docker compose run 을 쓰지 않는다. compose 가 서비스 환경변수를
                    # 주입하면 테스트가 깨진다. 예: FRONTEND_BASE_URL 이 4173 으로
                    # 들어가면 기본값 5173 을 기대하는 test_invite_to_api_computes_display_flags
                    # 가 실패한다. 배포 환경이 아니라 코드를 검사해야 하므로 환경변수 없이 돈다.
                    #
                    # tests/ 는 이미지에 없다 (Dockerfile 이 app/scripts/alembic 만 복사).
                    # 저장소 전체를 마운트해야 한다 — 일부 테스트가 저장소 레이아웃을
                    # 전제로 Path(__file__).parents[N] 로 경로를 계산한다.
                    # DB 도 필요 없다. 백엔드 테스트는 SQLite 인메모리 픽스처를 쓴다.
                    docker run --rm \
                      -v ${PROJECT_DIR}:/repo \
                      -w /repo/backend \
                      travel-hunter-backend-test \
                      python -m pytest tests -q
                '''
            }
        }

        stage('Validate Compose') {
            steps {
                sh '''
                    echo "===== Compose 설정 검증 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      config > /dev/null

                    echo "Compose configuration OK"
                '''
            }
        }


        stage('Build Images') {
            steps {
                sh '''
                    echo "===== Docker Image Build ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      build
                '''
            }
        }


        stage('Run DB Migration') {
            steps {
                sh '''
                    echo "===== DB Migration 실행 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      run --rm backend \
                      python -m alembic upgrade head
                '''
            }
        }


        stage('Deploy') {
            steps {
                sh '''
                    echo "===== 개발 서비스 배포 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      up -d --wait --wait-timeout 120
                '''
            }
        }


        stage('Check Containers') {
            steps {
                sh '''
                    echo "===== 컨테이너 상태 확인 ====="

                    cd ${PROJECT_DIR}

                    docker compose \
                      -p ${COMPOSE_PROJECT_NAME} \
                      --env-file ${ENV_FILE} \
                      -f ${COMPOSE_FILE} \
                      ps
                '''
            }
        }


        stage('Health Check') {
            steps {
                sh '''
                    echo "===== 내부 Caddy 테스트 ====="

                    cd ${PROJECT_DIR}

                    docker run --rm \
                      --network ${COMPOSE_PROJECT_NAME}_default \
                      curlimages/curl:8.11.1 \
                      -I \
                      -H "Host: ${DEV_DOMAIN}" \
                      http://caddy:80

                    echo "===== 외부 도메인 테스트 ====="

                    curl -fsS \
                      -o /dev/null \
                      -I ${DEV_URL} || {
                        echo "⚠️ 개발 도메인 응답 없음"
                        exit 1
                    }

                    echo "Health Check OK"
                '''
            }
        }
    }


    post {

        success {
            echo "개발 서버 배포 성공"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "good",
                failOnError: false,
                message: """
✅ *[DEV] Travel Hunter 개발서버 배포 성공*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• 소요 시간: `${currentBuild.durationString.replace(' and counting', '')}`
• 서비스: <${env.DEV_URL}|${env.DEV_DOMAIN}>
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        failure {
            echo "개발 서버 배포 실패. Jenkins Console Output 확인 필요"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "danger",
                failOnError: false,
                message: """
❌ *[DEV] Travel Hunter 개발서버 배포 실패*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        unstable {
            echo "빌드 결과 불안정"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "warning",
                failOnError: false,
                message: """
⚠️ *[DEV] Travel Hunter 개발서버 빌드 상태 불안정*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        aborted {
            echo "빌드 취소"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "warning",
                failOnError: false,
                message: """
⛔ *[DEV] Travel Hunter 개발서버 배포 취소*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }

    }
}
