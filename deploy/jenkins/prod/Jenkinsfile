pipeline {
    agent none

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        BRANCH_NAME = "ci/prod-jenkins"

        PROD_ENV_FILE = "/home/prod-deploy/prodtravelhunterapp/deploy/.env.prod"

        COMPOSE_FILE = "compose.yaml"
        COMPOSE_PROJECT_NAME = "prodtravelhunterapp"

        PROD_DOMAIN = "prod.travel-hunter.co.kr"
        PROD_URL = "https://prod.travel-hunter.co.kr"

        SLACK_CHANNEL = "#travel-hunter-build"
    }

    stages {

        stage('Notify Build Start') {
            agent { label 'dev' }

            steps {
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: '#439FE0',
                    failOnError: false,
                    message: """
🚀 *[PROD] Travel Hunter 운영 배포 시작*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 확인>
                    """.stripIndent().trim()
                )
            }
        }


        stage('Checkout Source') {
            agent { label 'dev' }

            steps {

                deleteDir()

                echo "===== GitHub Checkout ====="

                checkout scm

                sh '''
                    echo "===== Checkout 완료 ====="

                    echo "실행 서버:"
                    hostname

                    echo "실행 사용자:"
                    whoami

                    echo "Commit:"
                    git rev-parse --short HEAD

                    echo "Branch:"
                    git branch --show-current

                    echo "Git 상태:"
                    git status
                '''

                stash(
                    name: 'prod-source',
                    includes: '**/*',
                    useDefaultExcludes: false
                )

                echo "===== 소스코드 Stash 완료 ====="
            }
        }


        stage('Prepare Production') {
            agent { label 'prod' }

            steps {

                deleteDir()

                unstash 'prod-source'

                sh '''
                    set -e

                    echo "===== 운영 배포 소스 준비 ====="

                    echo "실행 서버:"
                    hostname

                    echo "실행 사용자:"
                    whoami

                    echo "Workspace:"
                    pwd

                    echo "===== Commit ====="
                    git rev-parse --short HEAD

                    echo "===== Docker 환경 ====="
                    docker --version
                    docker compose version

                    echo "===== 운영 환경변수 확인 ====="

                    if [ ! -f "${PROD_ENV_FILE}" ]; then
                        echo "❌ 운영 환경변수 파일이 없습니다."
                        echo "${PROD_ENV_FILE}"
                        exit 1
                    fi

                    echo "✅ 운영 환경변수 파일 확인 완료"
                '''
            }
        }


        stage('Validate Compose') {
            agent { label 'prod' }

            steps {

                sh '''
                    set -e

                    echo "===== Compose 설정 검증 ====="

                    docker compose \
                      -p "${COMPOSE_PROJECT_NAME}" \
                      --env-file "${PROD_ENV_FILE}" \
                      -f "${COMPOSE_FILE}" \
                      config > /dev/null

                    echo "✅ Compose 설정 검증 완료"
                '''
            }
        }


        stage('Build Images') {
            agent { label 'prod' }

            steps {

                sh '''
                    set -e

                    echo "===== Docker Image Build ====="

                    docker compose \
                      -p "${COMPOSE_PROJECT_NAME}" \
                      --env-file "${PROD_ENV_FILE}" \
                      -f "${COMPOSE_FILE}" \
                      build

                    echo "✅ Docker Image Build 완료"
                '''
            }
        }


        stage('Run DB Migration') {
            agent { label 'prod' }

            steps {

                sh '''
                    set -e

                    echo "===== DB Migration 실행 ====="

                    docker compose \
                      -p "${COMPOSE_PROJECT_NAME}" \
                      --env-file "${PROD_ENV_FILE}" \
                      -f "${COMPOSE_FILE}" \
                      run --rm backend \
                      python -m alembic upgrade head

                    echo "✅ DB Migration 완료"
                '''
            }
        }


        stage('Deploy Production') {
            agent { label 'prod' }

            steps {

                sh '''
                    set -e

                    echo "===== 운영 서비스 배포 ====="

                    docker compose \
                      -p "${COMPOSE_PROJECT_NAME}" \
                      --env-file "${PROD_ENV_FILE}" \
                      -f "${COMPOSE_FILE}" \
                      up -d --wait --wait-timeout 120

                    echo "✅ 운영 서비스 배포 완료"
                '''
            }
        }


        stage('Check Containers') {
            agent { label 'prod' }

            steps {

                sh '''
                    echo "===== 컨테이너 상태 확인 ====="

                    docker compose \
                      -p "${COMPOSE_PROJECT_NAME}" \
                      --env-file "${PROD_ENV_FILE}" \
                      -f "${COMPOSE_FILE}" \
                      ps
                '''
            }
        }


        stage('Health Check') {
            agent { label 'prod' }

            steps {

                sh '''
                    set -e

                    echo "===== 내부 Caddy 테스트 ====="

                    docker run --rm \
                      --network "${COMPOSE_PROJECT_NAME}_default" \
                      curlimages/curl:8.11.1 \
                      -I \
                      -H "Host: ${PROD_DOMAIN}" \
                      http://caddy:80

                    echo "===== 외부 도메인 테스트 ====="

                    curl -fsS \
                      -o /dev/null \
                      -I \
                      "${PROD_URL}"

                    echo "✅ Health Check 완료"
                '''
            }
        }
    }


    post {

        success {

            echo "운영 서버 배포 성공"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "good",
                failOnError: false,
                message: """
✅ *[PROD] Travel Hunter 운영 배포 성공*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• 소요 시간: `${currentBuild.durationString.replace(' and counting', '')}`
• 서비스: <${env.PROD_URL}|${env.PROD_DOMAIN}>
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        failure {

            echo "운영 서버 배포 실패. Jenkins Console Output 확인 필요"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "danger",
                failOnError: false,
                message: """
❌ *[PROD] Travel Hunter 운영 배포 실패*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        unstable {

            echo "빌드 결과 불안정"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "warning",
                failOnError: false,
                message: """
⚠️ *[PROD] Travel Hunter 운영 배포 상태 불안정*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }


        aborted {

            echo "빌드 취소"

            slackSend(
                channel: env.SLACK_CHANNEL,
                color: "warning",
                failOnError: false,
                message: """
⛔ *[PROD] Travel Hunter 운영 배포 취소*

• Job: `${env.JOB_NAME}`
• Build: `#${env.BUILD_NUMBER}`
• Branch: `${env.BRANCH_NAME}`
• <${env.BUILD_URL}|Jenkins 빌드 결과 확인>
                """.stripIndent().trim()
            )
        }
    }
}