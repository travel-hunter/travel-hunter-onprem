# 접근 로그 - docs/superpowers/plans/2026-09-22-caddy-service-status-log.md
# 모든 요청을 stdout 에 JSON 으로 남기되 필드는 화이트리스트다: 경로(쿼리 제거)·상태·소요시간·마스킹 IP.
# 헤더는 요청·응답 모두 통째로 버린다 - Referer 와 응답 Location 에 토큰이 실린다.
# 목적은 백엔드가 죽었을 때의 502 가 어딘가엔 남게 하는 것. 역추적은 백엔드 로그(request_id)가 맡는다.
{
  servers {
    trusted_proxies static 172.16.0.0/12
    client_ip_headers Cf-Connecting-Ip
  }
  # 기본 로거(http.log.error 등)도 요청을 통째로 찍는다 - 502 오류 줄에 쿼리·Referer 가 실린다. 같은 필터를 건다.
  # 접근 로그는 사이트 블록의 log 가 따로 내므로 여기서 제외해 두 번 찍히지 않게 한다.
  log default {
    output stdout
    exclude http.log.access
    format filter {
      wrap json
      fields {
        request>uri regexp \?.*$ ""
        request>headers delete
        resp_headers delete
        request>remote_ip delete
        request>remote_port delete
        request>client_ip ip_mask {
          ipv4 24
          ipv6 48
        }
      }
    }
  }
}

(accesslog) {
  log {
    # 볼륨의 파일에 쓴다. docker 가 관리하는 컨테이너 로그는 재배포 때 사라지므로 이력이 남지 않는다.
    # Caddy 는 접근 로그를 한 곳에만 쓸 수 있어(실측) stdout 과 병행하지 못한다. 기동·오류 줄은 기본 로거로 stdout 에 계속 남는다.
    output file /var/log/travelhunter/caddy-access.log {
      roll_size 20mb
      roll_keep 10
      roll_uncompressed
    }
    format filter {
      wrap json
      fields {
        request>uri regexp \?.*$ ""
        request>headers delete
        resp_headers delete
        request>remote_ip delete
        request>remote_port delete
        request>client_ip ip_mask {
          ipv4 24
          ipv6 48
        }
      }
    }
  }
}

http://{$STAGING_DOMAIN} {
  import accesslog
  # 요청마다 ID 를 만들어 백엔드로 넘긴다. 백엔드는 이 값을 자기 request_id 로 채택하므로
  # 문의 코드 하나로 Caddy 로그와 백엔드 로그가 같이 검색된다.
  # request_header 는 클라이언트가 보낸 값을 덮어쓰므로 위조 값이 뒤로 가지 못한다.
  request_header X-Request-Id {http.request.uuid}
  header ?X-Request-Id {http.request.uuid}
  handle_errors {
    # 백엔드가 죽으면 502 가 여기로 온다. 백엔드의 500 과 같은 형태로 코드를 돌려줘야
    # 프런트가 문의 코드를 표시할 수 있다(header ? 는 오류 응답에 붙지 않는다).
    header X-Request-Id {http.request.uuid}
    respond `{"detail":"Service Unavailable","requestId":"{http.request.uuid}"}` {err.status_code}
  }

  encode gzip zstd

  @admin_path path /admin /admin/*
  redir @admin_path https://{$ADMIN_DOMAIN}{uri} 302

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /docs* {
    reverse_proxy backend:8000
  }

  handle /openapi.json {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:4173
  }
}

http://{$ADMIN_DOMAIN} {
  import accesslog
  # 요청마다 ID 를 만들어 백엔드로 넘긴다. 백엔드는 이 값을 자기 request_id 로 채택하므로
  # 문의 코드 하나로 Caddy 로그와 백엔드 로그가 같이 검색된다.
  # request_header 는 클라이언트가 보낸 값을 덮어쓰므로 위조 값이 뒤로 가지 못한다.
  request_header X-Request-Id {http.request.uuid}
  header ?X-Request-Id {http.request.uuid}
  handle_errors {
    # 백엔드가 죽으면 502 가 여기로 온다. 백엔드의 500 과 같은 형태로 코드를 돌려줘야
    # 프런트가 문의 코드를 표시할 수 있다(header ? 는 오류 응답에 붙지 않는다).
    header X-Request-Id {http.request.uuid}
    respond `{"detail":"Service Unavailable","requestId":"{http.request.uuid}"}` {err.status_code}
  }

  encode gzip zstd

  @admin_root path /
  redir @admin_root /admin 302
# Keep static frontend assets reachable; redirecting JavaScript to HTML causes a blank page.
  @admin_non_app not path /admin /admin/* /login /assets/* /icons/* /manifest.webmanifest /favicon.ico /api/* /docs* /openapi.json
  redir @admin_non_app /admin 302

  handle /api/* {
    reverse_proxy backend:8000
  }

  handle /docs* {
    reverse_proxy backend:8000
  }

  handle /openapi.json {
    reverse_proxy backend:8000
  }

  handle {
    reverse_proxy frontend:4173
  }
}
